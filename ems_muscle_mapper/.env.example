# Copy this file to .env and replace the placeholder with a newly created key.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Leave blank to use OpenAI directly. Set only for a compatible gateway.
OPENAI_BASE_URL=
# Example: OPENAI_BASE_URL=https://example.com/v1

# Optional: defaults to gpt-4o.
# OPENAI_MODEL=gpt-4o
