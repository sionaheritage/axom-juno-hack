# Muscle Mapper image analysis
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# Optional pre-rendered Live Twin voice generation / conversational coach
ELEVENLABS_API_KEY=
AXON_AGENT_ID=agent_5601kydjajk9fnqtvwyn2ed4tmnd

# Live Twin camera: a local OpenCV index or an HTTP(S) camera stream URL
VIDEO_SOURCE=0

# TENS hardware is deliberately disabled by default. Leave all three safety
# switches at these values unless the physical rig and protocol are verified.
DRIVER_MOCK_MODE=true
BOARD_HOST=192.168.1.100
BOARD_PORT=5005
BOARD_CONTRACT_CONFIRMED=false
RELAY_PAIRING_CONFIRMED=false

# External pose-control UDP output is also disabled by default.
POSE_UDP_ENABLED=false
POSE_UDP_HOST=127.0.0.1
POSE_UDP_PORT=9090

# Placement calibration tuning
WRIST_PAD_OFFSET_PCT=0.08
DELT_PAD_OFFSET_PCT=0.10
MARKER_HSV_LOWER=140,80,80
MARKER_HSV_UPPER=170,255,255
